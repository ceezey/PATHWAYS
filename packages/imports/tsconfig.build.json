{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "rootDir": "./src",
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/fixtures/**/*",
    "src/form-draft/draft-test-support.ts",
    "src/form-draft/futuremakers-fixture.ts",
    "src/form-draft/futuremakers-stage-fixture.ts"
  ]
}
