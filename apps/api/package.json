{
  "name": "@pathways/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"@pathways/api^...\" run build && node ../../infra/supabase/security-adapter/dev-local.mjs",
    "dev:watch": "pnpm --filter \"@pathways/api^...\" run build && node ../../infra/supabase/security-adapter/dev-local.mjs --watch",
    "build": "pnpm --filter \"@pathways/api^...\" run build && prisma generate --config prisma.generate.config.ts && nest build",
    "start": "node dist/apps/api/src/main.js",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx prisma/check-connection.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@pathways/config": "workspace:*",
    "@pathways/imports": "workspace:*",
    "@pathways/shared": "workspace:*",
    "@prisma/client": "6.19.2",
    "@sentry/nestjs": "^10.76.2",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pdfkit": "0.20.2",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "puppeteer-core": "25.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "0.17.6",
    "dotenv": "^16.6.1",
    "prisma": "6.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
