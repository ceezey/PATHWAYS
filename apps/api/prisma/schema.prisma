model Program {
  report_program Report[] @relation("Report_program")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  code String
  name String
  description String?
  managerUserId String? @map("manager_user_id") @db.Uuid
  startDate DateTime? @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  status ProgramStatus  @default(PLANNED)
  archivedAt DateTime? @map("archived_at")  @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation("Program_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "programs_organization_fk")
  managerUser SystemUser? @relation("Program_managerUser", fields: [organizationId, managerUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "programs_manager_user_fk")
  project_program Project[] @relation("Project_program")

  @@unique([organizationId, id], map: "programs_scope_key")
  @@unique([organizationId, code], map: "programs_org_code_key")
  @@index([organizationId, status], map: "programs_org_status_idx")
  @@index([organizationId, managerUserId], map: "programs_manager_user_idx")
  @@map("programs")
  @@schema("pathways")
}

model Project {
  projectBudgetRecord_project ProjectBudgetRecord[] @relation("ProjectBudgetRecord_project")
  budgetExpenseEntry_project BudgetExpenseEntry[] @relation("BudgetExpenseEntry_project")
  assessmentResult_project AssessmentResult[] @relation("AssessmentResult_project")
  projectEvaluationCriterion_project ProjectEvaluationCriterion[] @relation("ProjectEvaluationCriterion_project")
  projectEvaluation_project ProjectEvaluation[] @relation("ProjectEvaluation_project")
  projectEvaluationScore_project ProjectEvaluationScore[] @relation("ProjectEvaluationScore_project")
  ruleBasedAlert_project RuleBasedAlert[] @relation("RuleBasedAlert_project")
  decisionRecommendation_project DecisionRecommendation[] @relation("DecisionRecommendation_project")
  evidenceMedia_project EvidenceMedia[] @relation("EvidenceMedia_project")
  report_project Report[] @relation("Report_project")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  programId String? @map("program_id") @db.Uuid
  code String
  title String
  description String?
  objectives String?
  implementationArea String? @map("implementation_area")
  startDate DateTime? @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  status ProjectStatus  @default(PLANNED)
  createdById String? @map("created_by_id") @db.Uuid
  archivedAt DateTime? @map("archived_at")  @db.Timestamptz(3)
  publicVisibilityStatus PublicVisibilityStatus @map("public_visibility_status") @default(PRIVATE)
  publicSummary String? @map("public_summary")
  publicSubmittedById String? @map("public_submitted_by_id") @db.Uuid
  publicSubmittedAt DateTime? @map("public_submitted_at")  @db.Timestamptz(3)
  publicApprovedById String? @map("public_approved_by_id") @db.Uuid
  publicApprovedAt DateTime? @map("public_approved_at")  @db.Timestamptz(3)
  publishedById String? @map("published_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at")  @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation("Project_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "projects_organization_fk")
  createdBy SystemUser? @relation("Project_createdBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "projects_created_by_fk")
  publicSubmittedBy SystemUser? @relation("Project_publicSubmittedBy", fields: [organizationId, publicSubmittedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "projects_public_submitted_by_fk")
  publicApprovedBy SystemUser? @relation("Project_publicApprovedBy", fields: [organizationId, publicApprovedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "projects_public_approved_by_fk")
  publishedBy SystemUser? @relation("Project_publishedBy", fields: [organizationId, publishedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "projects_published_by_fk")
  program Program? @relation("Project_program", fields: [organizationId, programId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "projects_program_fk")
  userProjectAssignment_project UserProjectAssignment[] @relation("UserProjectAssignment_project")
  projectActivity_project ProjectActivity[] @relation("ProjectActivity_project")
  projectActivityAssignment_project ProjectActivityAssignment[] @relation("ProjectActivityAssignment_project")
  projectMilestone_project ProjectMilestone[] @relation("ProjectMilestone_project")
  projectIndicator_project ProjectIndicator[] @relation("ProjectIndicator_project")
  digitalForm_project DigitalForm[] @relation("DigitalForm_project")
  formField_project FormField[] @relation("FormField_project")
  dataImportBatch_project DataImportBatch[] @relation("DataImportBatch_project")
  dataImportRow_project DataImportRow[] @relation("DataImportRow_project")
  metadataMapping_project MetadataMapping[] @relation("MetadataMapping_project")
  formSubmission_project FormSubmission[] @relation("FormSubmission_project")
  formResponseValue_project FormResponseValue[] @relation("FormResponseValue_project")
  beneficiaryProjectEnrollment_project BeneficiaryProjectEnrollment[] @relation("BeneficiaryProjectEnrollment_project")
  journeyStage_project JourneyStage[] @relation("JourneyStage_project")
  activityJourneyStageMapping_project ActivityJourneyStageMapping[] @relation("ActivityJourneyStageMapping_project")
  beneficiaryActivityParticipation_project BeneficiaryActivityParticipation[] @relation("BeneficiaryActivityParticipation_project")
  beneficiaryJourneyEvent_project BeneficiaryJourneyEvent[] @relation("BeneficiaryJourneyEvent_project")

  @@unique([organizationId, id], map: "projects_scope_key")
  @@unique([organizationId, code], map: "projects_org_code_key")
  @@index([organizationId, status], map: "projects_org_status_idx")
  @@index([organizationId, publicVisibilityStatus], map: "projects_org_public_idx")
  @@index([organizationId, createdById], map: "projects_created_by_idx")
  @@index([organizationId, publicSubmittedById], map: "projects_public_submitted_by_idx")
  @@index([organizationId, publicApprovedById], map: "projects_public_approved_by_idx")
  @@index([organizationId, publishedById], map: "projects_published_by_idx")
  @@index([organizationId, programId], map: "projects_program_idx")
  @@map("projects")
  @@schema("pathways")
}

model UserProjectAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  assignedById String @map("assigned_by_id") @db.Uuid
  status AssignmentStatus  @default(ACTIVE)
  assignedAt DateTime @map("assigned_at") @default(now()) @db.Timestamptz(3)
  endedAt DateTime? @map("ended_at")  @db.Timestamptz(3)
  endReason String? @map("end_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
