generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "pathways"]
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("organization_status")
  @@schema("pathways")
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED

  @@map("account_status")
  @@schema("pathways")
}

model Organization {
  projectBudgetRecord_organization ProjectBudgetRecord[] @relation("ProjectBudgetRecord_organization")
  budgetExpenseEntry_organization BudgetExpenseEntry[] @relation("BudgetExpenseEntry_organization")
  assessmentResult_organization AssessmentResult[] @relation("AssessmentResult_organization")
  projectEvaluationCriterion_organization ProjectEvaluationCriterion[] @relation("ProjectEvaluationCriterion_organization")
  projectEvaluation_organization ProjectEvaluation[] @relation("ProjectEvaluation_organization")
  projectEvaluationScore_organization ProjectEvaluationScore[] @relation("ProjectEvaluationScore_organization")
  alertRule_organization AlertRule[] @relation("AlertRule_organization")
  alertRuleCondition_organization AlertRuleCondition[] @relation("AlertRuleCondition_organization")
  alertRuleRecommendation_organization AlertRuleRecommendation[] @relation("AlertRuleRecommendation_organization")
  ruleBasedAlert_organization RuleBasedAlert[] @relation("RuleBasedAlert_organization")
  decisionRecommendation_organization DecisionRecommendation[] @relation("DecisionRecommendation_organization")
  evidenceMedia_organization EvidenceMedia[] @relation("EvidenceMedia_organization")
  report_organization Report[] @relation("Report_organization")
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique(map: "organizations_code_key")
  name             String
  organizationType String             @default("Humanitarian and Development Organization") @map("organization_type")
  description      String?
  contactEmail     String?            @map("contact_email")
  contactNumber    String?            @map("contact_number")
  address          String?
  status           OrganizationStatus @default(ACTIVE)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  systemUsers      SystemUser[]
  auditLogs        AuditLog[]
  program_organization Program[] @relation("Program_organization")
  project_organization Project[] @relation("Project_organization")
  userProjectAssignment_organization UserProjectAssignment[] @relation("UserProjectAssignment_organization")
  projectActivity_organization ProjectActivity[] @relation("ProjectActivity_organization")
  projectActivityAssignment_organization ProjectActivityAssignment[] @relation("ProjectActivityAssignment_organization")
  projectMilestone_organization ProjectMilestone[] @relation("ProjectMilestone_organization")
  projectIndicator_organization ProjectIndicator[] @relation("ProjectIndicator_organization")
  digitalForm_organization DigitalForm[] @relation("DigitalForm_organization")
  formField_organization FormField[] @relation("FormField_organization")
  dataImportBatch_organization DataImportBatch[] @relation("DataImportBatch_organization")
  dataImportRow_organization DataImportRow[] @relation("DataImportRow_organization")
  metadataMapping_organization MetadataMapping[] @relation("MetadataMapping_organization")
  formSubmission_organization FormSubmission[] @relation("FormSubmission_organization")
  formResponseValue_organization FormResponseValue[] @relation("FormResponseValue_organization")
  beneficiary_organization Beneficiary[] @relation("Beneficiary_organization")
  beneficiaryProjectEnrollment_organization BeneficiaryProjectEnrollment[] @relation("BeneficiaryProjectEnrollment_organization")
  journeyStage_organization JourneyStage[] @relation("JourneyStage_organization")
  activityJourneyStageMapping_organization ActivityJourneyStageMapping[] @relation("ActivityJourneyStageMapping_organization")
  beneficiaryActivityParticipation_organization BeneficiaryActivityParticipation[] @relation("BeneficiaryActivityParticipation_organization")
  beneficiaryJourneyEvent_organization BeneficiaryJourneyEvent[] @relation("BeneficiaryJourneyEvent_organization")

  @@index([status], map: "organizations_status_idx")
  @@map("organizations")
  @@schema("pathways")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique(map: "roles_code_key")
  name            String           @unique(map: "roles_name_key")
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]
  systemUsers     SystemUser[]

  @@map("roles")
  @@schema("pathways")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique(map: "permissions_code_key")
  name            String
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("pathways")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId], map: "role_permissions_pkey")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
  @@schema("pathways")
}

model SystemUser {
  projectBudgetRecord_recordedBy ProjectBudgetRecord[] @relation("ProjectBudgetRecord_recordedBy")
  budgetExpenseEntry_submittedBy BudgetExpenseEntry[] @relation("BudgetExpenseEntry_submittedBy")
  budgetExpenseEntry_verifiedBy BudgetExpenseEntry[] @relation("BudgetExpenseEntry_verifiedBy")
  budgetExpenseEntry_approvedBy BudgetExpenseEntry[] @relation("BudgetExpenseEntry_approvedBy")
  budgetExpenseEntry_rejectedBy BudgetExpenseEntry[] @relation("BudgetExpenseEntry_rejectedBy")
  assessmentResult_recordedBy AssessmentResult[] @relation("AssessmentResult_recordedBy")
  projectEvaluationCriterion_createdBy ProjectEvaluationCriterion[] @relation("ProjectEvaluationCriterion_createdBy")
  projectEvaluationCriterion_publishedBy ProjectEvaluationCriterion[] @relation("ProjectEvaluationCriterion_publishedBy")
  projectEvaluation_evaluatedBy ProjectEvaluation[] @relation("ProjectEvaluation_evaluatedBy")
  projectEvaluation_reviewedBy ProjectEvaluation[] @relation("ProjectEvaluation_reviewedBy")
  projectEvaluation_signedOffBy ProjectEvaluation[] @relation("ProjectEvaluation_signedOffBy")
  alertRule_createdBy AlertRule[] @relation("AlertRule_createdBy")
  alertRule_activatedBy AlertRule[] @relation("AlertRule_activatedBy")
  alertRuleRecommendation_createdBy AlertRuleRecommendation[] @relation("AlertRuleRecommendation_createdBy")
  ruleBasedAlert_evaluatedBy RuleBasedAlert[] @relation("RuleBasedAlert_evaluatedBy")
  decisionRecommendation_proposedBy DecisionRecommendation[] @relation("DecisionRecommendation_proposedBy")
  decisionRecommendation_reviewedBy DecisionRecommendation[] @relation("DecisionRecommendation_reviewedBy")
  decisionRecommendation_outcomeBy DecisionRecommendation[] @relation("DecisionRecommendation_outcomeBy")
  evidenceMedia_submittedBy EvidenceMedia[] @relation("EvidenceMedia_submittedBy")
  evidenceMedia_verifiedBy EvidenceMedia[] @relation("EvidenceMedia_verifiedBy")
  evidenceMedia_approvedBy EvidenceMedia[] @relation("EvidenceMedia_approvedBy")
  evidenceMedia_rejectedBy EvidenceMedia[] @relation("EvidenceMedia_rejectedBy")
  evidenceMedia_publicSubmittedBy EvidenceMedia[] @relation("EvidenceMedia_publicSubmittedBy")
  evidenceMedia_publicApprovedBy EvidenceMedia[] @relation("EvidenceMedia_publicApprovedBy")
  evidenceMedia_publishedBy EvidenceMedia[] @relation("EvidenceMedia_publishedBy")
  report_createdBy Report[] @relation("Report_createdBy")
  report_generatedBy Report[] @relation("Report_generatedBy")
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  roleId         String        @map("role_id") @db.Uuid
  authUserId     String?       @unique(map: "system_users_auth_user_id_key") @map("auth_user_id") @db.Uuid
  fullName       String        @map("full_name")
  email          String
  positionTitle  String?       @map("position_title")
  contactNumber  String?       @map("contact_number")
  accountStatus  AccountStatus @default(INVITED) @map("account_status")
  invitedAt      DateTime      @default(now()) @map("invited_at") @db.Timestamptz(3)
  activatedAt    DateTime?     @map("activated_at") @db.Timestamptz(3)
  suspendedAt    DateTime?     @map("suspended_at") @db.Timestamptz(3)
  deactivatedAt  DateTime?     @map("deactivated_at") @db.Timestamptz(3)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  lastLoginAt    DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditLogs      AuditLog[]    @relation("AuditActor")
  program_managerUser Program[] @relation("Program_managerUser")
  project_createdBy Project[] @relation("Project_createdBy")
  project_publicSubmittedBy Project[] @relation("Project_publicSubmittedBy")
  project_publicApprovedBy Project[] @relation("Project_publicApprovedBy")
  project_publishedBy Project[] @relation("Project_publishedBy")
  userProjectAssignment_assignedBy UserProjectAssignment[] @relation("UserProjectAssignment_assignedBy")
  projectActivity_createdBy ProjectActivity[] @relation("ProjectActivity_createdBy")
  projectActivity_reviewedBy ProjectActivity[] @relation("ProjectActivity_reviewedBy")
  projectActivityAssignment_assignedBy ProjectActivityAssignment[] @relation("ProjectActivityAssignment_assignedBy")
  projectIndicator_createdBy ProjectIndicator[] @relation("ProjectIndicator_createdBy")
  digitalForm_createdBy DigitalForm[] @relation("DigitalForm_createdBy")
  digitalForm_publishedBy DigitalForm[] @relation("DigitalForm_publishedBy")
  dataImportBatch_uploadedBy DataImportBatch[] @relation("DataImportBatch_uploadedBy")
  dataImportRow_validatedBy DataImportRow[] @relation("DataImportRow_validatedBy")
  formSubmission_submittedBy FormSubmission[] @relation("FormSubmission_submittedBy")
  formSubmission_validatedBy FormSubmission[] @relation("FormSubmission_validatedBy")
  beneficiary_createdBy Beneficiary[] @relation("Beneficiary_createdBy")
  beneficiaryProjectEnrollment_recordedBy BeneficiaryProjectEnrollment[] @relation("BeneficiaryProjectEnrollment_recordedBy")
  journeyStage_createdBy JourneyStage[] @relation("JourneyStage_createdBy")
  activityJourneyStageMapping_createdBy ActivityJourneyStageMapping[] @relation("ActivityJourneyStageMapping_createdBy")
  beneficiaryActivityParticipation_recordedBy BeneficiaryActivityParticipation[] @relation("BeneficiaryActivityParticipation_recordedBy")
  beneficiaryJourneyEvent_recordedBy BeneficiaryJourneyEvent[] @relation("BeneficiaryJourneyEvent_recordedBy")
  userProjectAssignment_user UserProjectAssignment[] @relation("UserProjectAssignment_user")

  @@unique([organizationId, id], map: "system_users_organization_id_id_key")
  @@index([organizationId, accountStatus], map: "system_users_organization_id_account_status_idx")
  @@index([roleId], map: "system_users_role_id_idx")
  @@map("system_users")
  @@schema("pathways")
}

model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  projectId      String?      @map("project_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  changes        Json?
  ipAddress      String?      @map("ip_address")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor          SystemUser?  @relation("AuditActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)], map: "audit_logs_org_occurred_idx")
  @@index([organizationId, projectId, occurredAt(sort: Desc)], map: "audit_logs_org_project_occurred_idx")
  @@index([organizationId, entityType, entityId, occurredAt(sort: Desc)], map: "audit_logs_org_entity_occurred_idx")
  @@index([organizationId, actorUserId, occurredAt(sort: Desc)], map: "audit_logs_org_actor_occurred_idx")
  @@map("audit_logs")
  @@schema("pathways")
}

